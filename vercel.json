{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/final-website", "destination": "/", "permanent": false },
    { "source": "/final-website-v2", "destination": "/", "permanent": false },
    { "source": "/website-v3", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
